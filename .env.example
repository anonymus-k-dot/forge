# ==============================================================================
# FORGE Environment Configuration Template
# Duplicate this file to .env and provide your actual API credentials.
# ==============================================================================

# Google Gemini API key for the default provider (Gemma 4 31B-IT prompt enhancement).
# The app starts without it; /enhance then returns a "not configured" error.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: provider/model configuration file (JSON, never contains secrets).
# Unset = packaged default (Gemini only). See config/providers.example.json.
# FORGE_PROVIDERS_FILE=config/providers.json

# Optional: credentials referenced by "api_key_env" in a providers file.
# GROQ_API_KEY=your_groq_api_key_here

# Optional: Server configuration
PORT=5000
FLASK_DEBUG=false
FLASK_ENV=production

# Optional: log level for FORGE's JSON logs on stderr (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Prompts, model output and credentials are not logged; only an unexpected internal
# error (a bug, not a provider failure) logs its traceback.
# FORGE_LOG_LEVEL=INFO

# Optional: PostgreSQL. The app starts without it; /ready then reports "not_configured".
# Local Docker database:  docker compose up -d db  then  alembic upgrade head
# DATABASE_URL=postgresql://forge:forge-local-dev-only@127.0.0.1:5433/forge
# Hosted PostgreSQL (Neon, Supabase, ...): paste the provider's connection string and require SSL.
# DATABASE_SSLMODE=require
# DATABASE_POOL_MODE=session   # "transaction" only for PgBouncer/Supavisor transaction pooling
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_POOL_TIMEOUT=10
# DATABASE_CONNECT_TIMEOUT=5

# Optional: response-cache entry lifetime for run executions (seconds; default 30 days).
# /enhance never uses the cache.
# FORGE_CACHE_TTL_SECONDS=2592000

# Optional: the docker-compose "db" service (local development only).
# POSTGRES_PASSWORD=choose-a-local-password
# POSTGRES_PORT=5433

# Optional: PostgreSQL tests. Throwaway forge_test_* databases are created and dropped on
# this server. Non-local hosts, port 5432 and servers holding other databases are refused.
# Never point this at a database you care about.
# TEST_DATABASE_URL=postgresql://forge:forge-local-dev-only@127.0.0.1:5433/postgres
